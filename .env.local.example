# ==============================================================================
# Environment Configuration Template for AI Course Generator
# Copy this file to .env.local and fill in your actual credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Clerk Authentication
# Obtain these from: https://dashboard.clerk.com/ -> API Keys
# ------------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key

# Clerk Route Redirects
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/

# ------------------------------------------------------------------------------
# 2. Google Gemini AI (Core Engine for Course & Chapter Generation)
# Obtain your key from: https://aistudio.google.com/app/apikey
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
NEXT_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 3. Database (PostgreSQL / Neon Serverless Postgres)
# Obtain connection string from: https://neon.tech
# Format: postgresql://[user]:[password]@[host]/[dbname]?sslmode=require
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require

# ------------------------------------------------------------------------------
# 4. YouTube Data API v3 (For video chapter tutorials)
# Obtain from: https://console.cloud.google.com/apis/credentials
# ------------------------------------------------------------------------------
NEXT_PUBLIC_YOUTUBE_API_KEY=your_youtube_data_api_v3_key

# ------------------------------------------------------------------------------
# 5. Application Host
# ------------------------------------------------------------------------------
NEXT_PUBLIC_HOST_NAME=http://localhost:3000/

# ------------------------------------------------------------------------------
# 6. Admin User IDs (Optional)
# Comma-separated Clerk User IDs who should have administrative privileges
# Example: user_2aX...,user_3bY...
# ------------------------------------------------------------------------------
ADMIN_USERS=

# ------------------------------------------------------------------------------
# 7. Additional / Optional Media Generation Integrations
# ------------------------------------------------------------------------------
ELEVENLABS_API_KEY=your_elevenlabs_api_key
PEXELS_API_KEY=your_pexels_api_key
YOUTUBE_CLIENT_ID=your_oauth_client_id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=your_oauth_client_secret
YOUTUBE_REDIRECT_URI=http://localhost:3000/api/auth/youtube/callback
